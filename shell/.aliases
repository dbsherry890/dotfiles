# ── Navigation ──────────────────────────────────────────────────────────────
alias ..='cd ..'

# ── Listing ─────────────────────────────────────────────────────────────────
alias ls="eza -1 --icons=always --group-directories-first --classify=auto"
alias la="ls -aF"
alias ll="ls -lF"
alias l="la -F"

# ── Editing ─────────────────────────────────────────────────────────────────
alias bashrc="nvim ~/.bashrc"
alias zshrc="nvim ~/.zshrc"
alias dot="nvim ~/dotfiles"

# ── Git ──────────────────────────────────────────────────────────────────────
alias ga="git add ."
alias gb="git branch"
alias gc="git commit -m "
alias gl="git log --oneline --decorate --all --graph"
alias gp="git push"
alias gs="git status"
alias gco="git checkout"

# ── Tmux ─────────────────────────────────────────────────────────────────────
alias ta='tmux attach -t'
alias tls='tmux ls'
alias tn='tmux new -s'
alias tk='tmux kill-session -t'

# ── tldr ─────────────────────────────────────────────────────────────────────
export PAGER="bat -l md"
export MANPAGER="less -R"
alias tldr='tldr --pager'

# ── Misc ──────────────────────────────────────────────────────────────────────
alias c="clear"
alias cm="cmatrix"
alias e="exit"
alias grep="grep --color=auto"
alias py=python3
alias src="source .venv/bin/activate"
alias d="docker"
alias dc="docker compose"
alias k="kubectl"
#
# ── Obsidian ──────────────────────────────────────────────────────────────────
alias learn="cd ~/obsidian/learning/ && nvim"
alias notes="cd ~/obsidian/ercotnotes/ && nvim"

# ── Launch ────────────────────────────────────────────────────────────────────
alias github="open https://github.com/dbsherry890"
alias rm='rm -i'

# ── OpenShift ─────────────────────────────────────────────────────────────────
alias ocd='oc config use-context aia-dev'
alias oct='oc config use-context aia-test'
alias ocp='oc config use-context aia-prod-taylor'
alias occ='oc config current-context'
alias ocgc='oc config get-contexts'

# ── C ─────────────────────────────────────────────────────────────────────────
# CFLAGS is the variable make's built-in C rule reads for compiler flags.
# Exporting it means every `make <name>` (with no Makefile) uses these flags.
#   -Wall -Wextra -> most useful warnings on
#   -std=c17      -> modern C standard
#   -g            -> debug info for lldb/gdb
export CFLAGS="-Wall -Wextra -std=c17 -g"

# mr = "make & run". Pass the program name with or without .c
# Usage: mr hello        -> builds hello.c into ./hello, then runs it
#        mr wc input.txt -> extra args are passed to your program
mr() {
  local name="${1%.c}"  # target name, e.g. "hello" (make looks for hello.c)
  shift                 # remaining args belong to your program
  make "$name" && "./$name" "$@"  # only run if the build succeeded
}
