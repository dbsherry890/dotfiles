# ── Navigation ──────────────────────────────────────────────────────────────
alias ..='cd ..'

# ── Listing ─────────────────────────────────────────────────────────────────
alias ls="eza -1 --icons=always --group-directories-first --classify=auto"
alias la="ls -aF"
alias ll="ls -lF"
alias l="la -F"

# ── Editing ─────────────────────────────────────────────────────────────────
alias bashrc="nvim ~/.bashrc"
alias zshrc="nvim ~/.zshrc"
alias dot="nvim ~/dotfiles"

# ── Git ──────────────────────────────────────────────────────────────────────
alias ga="git add ."
alias gb="git branch"
alias gc="git commit -m "
alias gl="git log --oneline --decorate --all --graph"
alias gp="git push"
alias gs="git status"

# ── Tmux ─────────────────────────────────────────────────────────────────────
alias ta='tmux attach -t'
alias tls='tmux ls'
alias tn='tmux new -s'

# ── tldr ─────────────────────────────────────────────────────────────────────
export PAGER="bat -l md"
export MANPAGER="less -R"
alias tldr='tldr --pager'

# ── Misc ──────────────────────────────────────────────────────────────────────
alias c="clear"
alias cm="cmatrix"
alias e="exit"
alias grep="grep --color=auto"
alias py=python3
alias src="source .venv/bin/activate"
# alias copilot="copilot -i 'Talk like a caveman, and use karpathy guidelines'"
alias d="docker"
alias kube="kubectl"
#
# ── Obsidian ──────────────────────────────────────────────────────────────────────
alias notes="cd ~/obsidian && nvim" # subshell so you don't stay in ~/obsidian

# ── Launch ──────────────────────────────────────────────────────────────────────
alias github="open https://github.com/dbsherry890"

alias rm='rm -i'
